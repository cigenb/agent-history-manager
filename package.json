{
  "name": "agent-history-manager",
  "productName": "Agent History Manager",
  "version": "0.2.3",
  "description": "Browse and manage Claude Code, Codex and Grok conversations by project",
  "author": "cigenb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cigenb/agent-history-manager.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test scripts/*.test.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "io.github.cigenb.agent-history-manager",
    "productName": "Agent History Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": "zip",
      "icon": "build/icon.ico",
      "artifactName": "Agent-History-Manager-${version}-win-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
